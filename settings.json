{
    //  Theme Style
    "workbench.colorTheme": "Tokyo Night Storm",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.productIconTheme": "material-product-icons",
    "workbench.colorCustomizations": {
        "minimap.background": "#1e1e1e00",
        "editorGroup.emptyBackground": "#1e1e1e00",
        "welcomePage.background": "#1e1e1e00",
        "walkThrough.embeddedEditorBackground": "#1e1e1e00",
        "titleBar.activeBackground": "#1e1e1e00",
        "titleBar.inactiveBackground": "#1e1e1e00",
        "commandCenter.background": "#1e1e1e00",
        "window.activeBorder": "#1e1e1e00",
        "window.inactiveBorder": "#1e1e1e00",
        "terminal.background": "#00000000",
        "editorPane.background": "#1a1b2600",
        "editorGroupHeader.tabsBackground": "#1a1b2600",
        "editorGroupHeader.noTabsBackground": "#1a1b2600",
        "breadcrumb.background": "#1a1b2600",
        "editorGutter.background": "#1a1b2600",
        "tab.activeBackground": "#1a1b2600",
        "tab.unfocusedActiveBackground": "#1a1b2600",
        "panel.background": "#1a1b2600",
        "sideBar.background": "#1a1b2633",
        "sideBarTitle.background": "#1a1b2633",
        "activityBar.background": "#1a1b2633",
        "editor.background": "#1a1b2633",
        "tab.inactiveBackground": "#1a1b2633",
        "tab.unfocusedInactiveBackground": "#1a1b2633",
        "editorStickyScroll.background": "#1a1b26bf",
        "editorStickyScrollGutter.background": "#1a1b26bf",
        "sideBarStickyScroll.background": "#1a1b26bf",
        "panelStickyScroll.background": "#1a1b26bf",
        "terminalStickyScroll.background": "#1a1b26bf",
        "inlineChat.background": "#1a1b26e6",
        "editorWidget.background": "#1a1b26e6",
        "editorHoverWidget.background": "#1a1b26e6",
        "editorSuggestWidget.background": "#1a1b26e6",
        "notifications.background": "#1a1b26e6",
        "notificationCenterHeader.background": "#1a1b26e6",
        "menu.background": "#1a1b26e6",
        "quickInput.background": "#1a1b26e6",
        "input.background": "#1a1b26"
    },
    // Vibrancy
    "vscode_vibrancy.opacity": 0.2, //0-1
    "vscode_vibrancy.theme": "Tokyo Night Storm",
    //  Animation
    "animations.Enabled": true,
    //  Window
    "window.controlsStyle": "custom",
    "window.titleBarStyle": "custom",
    "window.systemColorTheme": "dark",
    "window.autoDetectColorScheme": false,
    "window.zoomLevel": 0,
    //  Terminal settings
    "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.initialHint": false,
    //  Font settings
    "editor.fontFamily": "'JetBrains Mono', 'Fira Code'",
    "editor.fontSize": 13,
    "editor.fontLigatures": true,
    "editor.lineHeight": 22,
    //  Code editing settings
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.renderWhitespace": "boundary",
    "editor.cursorBlinking": "smooth",
    //  Indent Rainbow   
    "indentRainbow.colors": [
        "rgba(255,255,255,0.03)",
        "rgba(255,255,255,0.06)",
        "rgba(255,255,255,0.09)",
        "rgba(255,255,255,0.12)"
    ],
    //  Browser
    "workbench.browser.searchEngine": "google",
    "workbench.browser.showInTitleBar": true,
    //  Error Lens
    "errorLens.enabledDiagnosticLevels": [
        // "warning",
        "error"
    ],
    "errorLens.messageEnabled": true,
    "errorLens.messageBackgroundMode": "message",
    "errorLens.messageTemplate": "$severity Msg: $message", // "$severity [$source:$code] $message",
    "errorLens.messageMaxChars": 200,
    "errorLens.gutterIconsEnabled": true,
    "errorLens.statusBarIconsEnabled": true,
    //  Custom CSS and JS Loader
    "vscode_custom_css.imports": [
        "file:///Users/watsonliu/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js"
    ],
    //  Pylance
    "python.analysis.typeCheckingMode": "basic",
    //  github-copilot
    "github.copilot.nextEditSuggestions.eagerness": "auto",
    //  exploere
    "explorer.confirmDelete": false,
    "explorer.confirmPasteNative": false,
    "explorer.confirmDragAndDrop": false,
}
